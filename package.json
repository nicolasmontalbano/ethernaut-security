{
  "name": "ethernaut-security",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible Ethernaut security research with Foundry and TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx scripts/cli.ts",
    "levels": "npm run cli -- levels",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "viem": "^2.39.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}

